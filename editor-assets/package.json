{
  "name": "nexg-editor-assets",
  "version": "1.0.0",
  "private": true,
  "description": "Build-time-only asset pipeline for the CodeMirror 6 editor bundled into the NexG IDE Android app. Node is NOT a runtime dependency: the generated editor.js/editor.css/index.html are checked into app/src/main/assets/editor/.",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": {
    "esbuild": "0.25.4"
  }
}