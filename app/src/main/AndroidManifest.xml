<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Phase 1 permissions.

      INTERNET: required by the Tier 1 architecture (Gemini API over HTTPS,
      PLAN.MD 4.9). Declared here because it is part of the app's purpose,
      not because Phase 1 calls the network.

      NOT yet declared, intentionally:
        RECORD_AUDIO  - added in Phase 14 (Voice).
      Both are runtime-requested in their own phase, not preemptively.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".NexGApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.NexG">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.NexG"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
