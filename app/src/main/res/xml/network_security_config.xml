<?xml version="1.0" encoding="utf-8"?>
<!--
  network_security_config

  Phase 1 scope: the app makes no network calls yet. This file exists so the
  security posture is decided once, not retrofitted.

  Base config: HTTPS only. Cleartext is denied globally.

  Local cleartext exemption: OpenCodeBackend (PLAN.MD 4.9, Phase 12) talks to
  http://127.0.0.1:4096. Cleartext to localhost is blocked by default at
  targetSdk 28+, and Android grants no automatic localhost exemption, so it
  must be declared explicitly. Scoped to loopback only — no wildcard.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
