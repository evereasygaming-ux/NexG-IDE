<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Light variant of the platform theme. The app's real colours come from
      Compose (ui/theme). This exists so the system decides the correct
      starting surface for light mode, and so there is no action bar.
    -->
    <style name="Theme.NexG" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
